{
  "description": "Reminds to run the full test gate before a git push to a deploying branch. Never blocks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/push-gate-reminder.mjs"]
          }
        ]
      }
    ]
  }
}
